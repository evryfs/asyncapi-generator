<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>complete-configuration</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson-annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>${spring-kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-kotlin</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>dev.banking.asyncapi.generator</groupId>
                <artifactId>asyncapi-generator-maven-plugin</artifactId>
                <version>${asyncapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>kotlin-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <outputDirectory>generated/kotlin</outputDirectory>
                            <outputFile>bundles/asyncapi.yaml</outputFile>
                            <modelPackage>com.example.complete.kotlin.model</modelPackage>
                            <clientPackage>com.example.complete.kotlin.client</clientPackage>
                            <modelConfig>
                                <modelAnnotation>com.example.codegen.GeneratedPayload</modelAnnotation>
                            </modelConfig>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>java-records</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <outputDirectory>generated/java</outputDirectory>
                            <modelPackage>com.example.complete.java.model</modelPackage>
                            <modelConfig>
                                <modelType>java-record</modelType>
                                <modelAnnotation>com.example.codegen.GeneratedPayload</modelAnnotation>
                            </modelConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native-avro</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/native-avro.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <outputDirectory>generated/avro</outputDirectory>
                            <modelPackage>com.example.complete.avro</modelPackage>
                            <modelConfig>
                                <modelType>avro-specific-record</modelType>
                            </modelConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>native-protobuf</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/native-protobuf.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <outputDirectory>generated/protobuf</outputDirectory>
                            <modelPackage>com.example.complete.protobuf</modelPackage>
                            <modelConfig>
                                <modelType>protobuf-message</modelType>
                            </modelConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>avro-schema</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>avro-schema</generatorName>
                            <outputDirectory>generated/schemas/avro</outputDirectory>
                            <schemaPackage>com.example.complete.schema.avro</schemaPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>protobuf-schema</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/native-protobuf.yaml</inputSpec>
                            <generatorName>protobuf-schema</generatorName>
                            <outputDirectory>generated/schemas/protobuf</outputDirectory>
                            <schemaPackage>com.example.complete.schema.protobuf</schemaPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>json-schema</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>json-schema</generatorName>
                            <outputDirectory>generated/schemas/json</outputDirectory>
                            <schemaPackage>com.example.complete.schema.json</schemaPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>asyncapi-yaml</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>asyncapi-yaml</generatorName>
                            <outputFile>documents/asyncapi.yaml</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>asyncapi-json</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/asyncapi.yaml</inputSpec>
                            <generatorName>asyncapi-json</generatorName>
                            <outputFile>documents/asyncapi.json</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
