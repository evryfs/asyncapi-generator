<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>external-references</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson-annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>${spring-kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>dev.banking.asyncapi.generator</groupId>
                <artifactId>asyncapi-generator-maven-plugin</artifactId>
                <version>${asyncapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>reference-forms</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/reference-forms/asyncapi.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <modelPackage>com.example.references.model</modelPackage>
                            <clientPackage>com.example.references.client</clientPackage>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>external-message</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/external-message/asyncapi.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <modelPackage>com.example.message.model</modelPackage>
                            <clientPackage>com.example.message.client</clientPackage>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>message-models</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/message-models/main.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <outputFile>bundles/message-models.yaml</outputFile>
                            <modelPackage>com.example.external.model</modelPackage>
                            <clientPackage>com.example.external.client</clientPackage>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                        </configuration>
                    </execution>
                    <execution>
                        <id>recursive-kotlin</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/recursive/asyncapi.yaml</inputSpec>
                            <generatorName>kotlin</generatorName>
                            <outputFile>bundles/recursive-kotlin.yaml</outputFile>
                            <modelPackage>com.example.recursive.kotlin</modelPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>recursive-java</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/asyncapi/recursive/asyncapi.yaml</inputSpec>
                            <generatorName>java</generatorName>
                            <outputFile>bundles/recursive-java.yaml</outputFile>
                            <modelPackage>com.example.recursive.java</modelPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
