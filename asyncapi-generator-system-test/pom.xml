<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.banking.asyncapi.generator</groupId>
        <artifactId>asyncapi-generator</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>asyncapi-generator-system-test</artifactId>
    <name>asyncapi-generator-system-test</name>
    <description>End-to-end tests that run the CLI, Maven plugin, and Gradle plugin against real consumer builds. Never published.</description>

    <properties>
        <system-test.repository>${project.build.directory}/system-test-repo</system-test.repository>
        <system-test.gradle.version>9.5.1</system-test.gradle.version>
        <system-test.process-timeout-seconds>600</system-test.process-timeout-seconds>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- frontends under test; staged into system-test.repository before the tests run -->
        <dependency>
            <groupId>dev.banking.asyncapi.generator</groupId>
            <artifactId>asyncapi-generator-cli</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.banking.asyncapi.generator</groupId>
            <artifactId>asyncapi-generator-maven-plugin</artifactId>
            <version>${project.version}</version>
            <type>maven-plugin</type>
            <scope>test</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${maven.compiler.target}</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <!-- Stages core, CLI, and Maven plugin into an isolated local repository. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.9.1</version>
                <executions>
                    <execution>
                        <id>stage-frontends</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                        <configuration>
                            <localRepositoryPath>${system-test.repository}</localRepositoryPath>
                            <!-- invoker.skip only skips the Maven plugin's own ITs, never staging -->
                            <skipInstallation>false</skipInstallation>
                            <scope>test</scope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Publishes the Gradle plugin into the same repository; core resolves from it through mavenLocal(). -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-gradle-plugin</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${project.basedir}/../asyncapi-generator-gradle-plugin</workingDirectory>
                            <executable>./gradlew</executable>
                            <arguments>
                                <argument>publishToMavenLocal</argument>
                                <argument>--quiet</argument>
                                <argument>-PasyncApiGeneratorVersion=${project.version}</argument>
                                <argument>-Dmaven.repo.local=${system-test.repository}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*SystemTest</include>
                    </includes>
                    <systemPropertyVariables>
                        <system-test.version>${project.version}</system-test.version>
                        <system-test.repository>${system-test.repository}</system-test.repository>
                        <system-test.user-repository>${settings.localRepository}</system-test.user-repository>
                        <system-test.maven-home>${maven.home}</system-test.maven-home>
                        <system-test.kotlin.version>${kotlin.version}</system-test.kotlin.version>
                        <system-test.spring-kafka.version>${spring-kafka.version}</system-test.spring-kafka.version>
                        <system-test.jakarta-validation.version>${jakarta-validation.version}</system-test.jakarta-validation.version>
                        <system-test.jackson-annotations.version>${jackson-annotations.version}</system-test.jackson-annotations.version>
                        <system-test.junit.version>${junit.jupiter.version}</system-test.junit.version>
                        <system-test.jackson.version>${jackson.version}</system-test.jackson.version>
                        <system-test.avro.version>${avro.version}</system-test.avro.version>
                        <system-test.protobuf.version>${protobuf.java.version}</system-test.protobuf.version>
                        <system-test.gradle.version>${system-test.gradle.version}</system-test.gradle.version>
                        <system-test.gradle-wrapper>${project.basedir}/../asyncapi-generator-gradle-plugin</system-test.gradle-wrapper>
                        <system-test.scenarios>${project.basedir}/src/test/scenarios</system-test.scenarios>
                        <system-test.check-support>${project.basedir}/src/test/check-support</system-test.check-support>
                        <system-test.work>${project.build.directory}/system-test-work</system-test.work>
                        <system-test.process-timeout-seconds>${system-test.process-timeout-seconds}</system-test.process-timeout-seconds>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
