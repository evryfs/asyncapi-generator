{
  "type": "record",
  "name": "Task",
  "namespace": "com.example.avro",
  "fields": [
    {
      "name": "id",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "status",
      "type": ["com.example.avro.TaskStatus", "null"],
      "default": "IN_PROGRESS"
    },
    {
      "name": "priority",
      "type": ["com.example.avro.Priority", "null"],
      "default": "MEDIUM"
    }
  ]
}
