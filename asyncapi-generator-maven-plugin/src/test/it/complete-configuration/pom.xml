<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.banking.asyncapi.generator.it</groupId>
    <artifactId>complete-configuration</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <kotlin.version>2.2.0</kotlin.version>
        <spring-kafka.version>3.3.16</spring-kafka.version>
        <jakarta-validation.version>3.1.1</jakarta-validation.version>
        <avro.version>1.12.1</avro.version>
        <protobuf.version>3.25.5</protobuf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>${spring-kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-kotlin</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.banking.asyncapi.generator</groupId>
                <artifactId>asyncapi-generator-maven-plugin</artifactId>
                <version>1.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>generate-kotlin-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>kotlin</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputFile>${project.build.directory}/bundled/asyncapi.yaml</outputFile>
                            <outputDirectory>${project.build.directory}/generated-sources/kotlin</outputDirectory>
                            <modelPackage>com.example.complete.kotlin.model</modelPackage>
                            <clientPackage>com.example.complete.kotlin.client</clientPackage>
                            <modelConfig>
                                <modelAnnotation>com.example.codegen.GeneratedPayload</modelAnnotation>
                            </modelConfig>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-java-records</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>java</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/java</outputDirectory>
                            <modelPackage>com.example.complete.java.model</modelPackage>
                            <modelConfig>
                                <modelType>java-record</modelType>
                                <modelAnnotation>com.example.codegen.GeneratedPayload</modelAnnotation>
                            </modelConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-native-avro</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>java</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/native-avro.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <modelPackage>com.example.complete.avro</modelPackage>
                            <modelConfig>
                                <modelType>avro-specific-record</modelType>
                            </modelConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-native-protobuf</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>kotlin</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/native-protobuf.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/protobuf</outputDirectory>
                            <modelPackage>com.example.complete.protobuf</modelPackage>
                            <modelConfig>
                                <modelType>protobuf-message</modelType>
                            </modelConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-avro-schema-only</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>avro-schema</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-schemas/avro</outputDirectory>
                            <schemaPackage>com.example.complete.schema.avro</schemaPackage>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-protobuf-schema-only</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>protobuf-schema</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/native-protobuf.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-schemas/protobuf</outputDirectory>
                            <schemaPackage>com.example.complete.schema.protobuf</schemaPackage>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-json-schema-only</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>json-schema</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-schemas/json</outputDirectory>
                            <schemaPackage>com.example.complete.schema.json</schemaPackage>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-asyncapi-yaml</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>asyncapi-yaml</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputFile>${project.build.directory}/documents/asyncapi.yaml</outputFile>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-asyncapi-json</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>asyncapi-json</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputFile>${project.build.directory}/documents/asyncapi.json</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <jvmTarget>${maven.compiler.release}</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>java-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
