<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.banking.asyncapi.generator.it</groupId>
    <artifactId>complete-configuration</artifactId>
    <version>1.0-SNAPSHOT</version>

    <build>
        <plugins>
            <plugin>
                <groupId>dev.banking.asyncapi.generator</groupId>
                <artifactId>asyncapi-generator-maven-plugin</artifactId>
                <version>1.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>generate-kotlin-client</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>kotlin</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputFile>${project.build.directory}/bundled/asyncapi.yaml</outputFile>
                            <outputDirectory>${project.build.directory}/generated-sources/kotlin</outputDirectory>
                            <modelPackage>com.example.complete.kotlin.model</modelPackage>
                            <clientPackage>com.example.complete.kotlin.client</clientPackage>
                            <schemaPackage>com.example.complete.kotlin.schema</schemaPackage>
                            <modelConfig>
                                <modelAnnotation>com.example.codegen.GeneratedPayload</modelAnnotation>
                            </modelConfig>
                            <clientConfig>
                                <clientType>spring-kafka</clientType>
                                <clientContract>interface</clientContract>
                                <producer>
                                    <enabled>true</enabled>
                                </producer>
                                <consumer>
                                    <enabled>true</enabled>
                                </consumer>
                                <topicParameterProperties>
                                    <environment>kafka.environment</environment>
                                </topicParameterProperties>
                                <validationAnnotations>
                                    <clientContract>org.springframework.validation.annotation.Validated</clientContract>
                                    <payloadParameter>jakarta.validation.Valid</payloadParameter>
                                </validationAnnotations>
                            </clientConfig>
                            <schemaConfig>
                                <avroProjection>
                                    <enabled>true</enabled>
                                </avroProjection>
                            </schemaConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-java-records</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>java</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/asyncapi.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/java</outputDirectory>
                            <modelPackage>com.example.complete.java.model</modelPackage>
                            <modelConfig>
                                <modelType>java-record</modelType>
                            </modelConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-native-avro</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>java</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/native-avro.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <modelPackage>com.example.complete.avro</modelPackage>
                            <modelConfig>
                                <modelType>avro-specific-record</modelType>
                            </modelConfig>
                            <schemaConfig>
                                <nativeAvro>
                                    <enabled>true</enabled>
                                </nativeAvro>
                            </schemaConfig>
                        </configuration>
                    </execution>

                    <execution>
                        <id>generate-native-protobuf</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <generatorName>kotlin</generatorName>
                            <inputSpec>${project.basedir}/src/main/resources/native-protobuf.yaml</inputSpec>
                            <outputDirectory>${project.build.directory}/generated-sources/protobuf</outputDirectory>
                            <modelPackage>com.example.complete.protobuf</modelPackage>
                            <modelConfig>
                                <modelType>protobuf-message</modelType>
                            </modelConfig>
                            <schemaConfig>
                                <nativeProtobuf>
                                    <enabled>true</enabled>
                                </nativeProtobuf>
                            </schemaConfig>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
